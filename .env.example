APP_ENV=development
# VSCODE_ENV is an optional fallback when APP_ENV is not set.
VSCODE_ENV=development

SERVICE_HOST=127.0.0.1
SERVICE_PORT=8001

# Use "openai" for the OpenAI Whisper API, or any other value such as "local"
# for the local faster-whisper adapter.
STT_ENGINE=openai
STT_LANGUAGE=en

# Required when STT_ENGINE=openai. Do not commit real secrets.
OPENAI_API_KEY=

# Optional external HTTP audio stream consumed on FastAPI startup.
AUTOLOAD_VOICE_STREAM_URL=
