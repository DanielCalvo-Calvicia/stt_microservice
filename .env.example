# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=STT Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8001
LOG_LEVEL=INFO
# "openai" = OpenAI Whisper API; any other value (e.g. "local") = local faster-whisper
STT_ENGINE=openai
# ISO-639-1 code forced on the transcription, e.g. "en" or "es"
STT_LANGUAGE=en
# Required when STT_ENGINE=openai
OPENAI_API_KEY=
# OpenAI engine only: words the model should spell as written here (e.g. the wake phrase "Oblivion 306"), which
# stops it writing "Obi-Wan 306". Empty = no hint. Check it does not make silence come back as these words
STT_PROMPT=
# --- Local engine (faster-whisper on the CPU) ---------------------------------------------------------------------

# Model of the local engine, downloaded on first load. small.en is English only: use "small" or similar for
# other languages (with STT_LANGUAGE)
STT_MODEL=small.en
# CPU threads of every local model, the gate's too. 0 = let ctranslate2 choose; a bad value stops the start
STT_THREADS=2
# Compute type of every local model: int8 is the fastest on a CPU, float32 the most exact. A name the CPU does not
# support fails when the model loads
STT_COMPUTE_TYPE=int8
# --- Wake-phrase gate (optional) -------------------------------------------------------------------------------
# 1 = also run a small LOCAL speech-to-text (free: no tokens) on routes under /gate. Brain listens there for the
# wake phrase and only sends the utterances that carry it to the real engine above. Needs the faster-whisper model
STT_GATE_ENABLED=0
# faster-whisper model of the gate. base (multilingual) heard the wake phrase far better than tiny.en on a real mic;
# small.en is more exact and about 3x slower. The .en models are English only
STT_GATE_MODEL=base
# Text that biases the gate toward the wake phrase: give it the name AND the code, as in Brain's WAKE_PHRASE ("Oblivion 306")
STT_GATE_PROMPT=Oblivion 306.
