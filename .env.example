# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=STT Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8001
LOG_LEVEL=INFO
# "openai" = OpenAI Whisper API; any other value (e.g. "local") = local faster-whisper
STT_ENGINE=openai
# ISO-639-1 code forced on the transcription, e.g. "en" or "es"
STT_LANGUAGE=en
# Required when STT_ENGINE=openai
OPENAI_API_KEY=
# OpenAI engine only: words the model should spell as written here (e.g. the wake phrase "Oblivion 306"), which
# stops it writing "Obi-Wan 306". Empty = no hint. Check it does not make silence come back as these words
STT_PROMPT=
# --- Wake-phrase gate (optional) -------------------------------------------------------------------------------
# 1 = also run a small LOCAL speech-to-text (free: no tokens) on routes under /gate. Brain listens there for the
# wake phrase and only sends the utterances that carry it to the real engine above. Needs the faster-whisper model
STT_GATE_ENABLED=0
# faster-whisper model of the gate: tiny.en is the fastest, base.en is more accurate (English only)
STT_GATE_MODEL=tiny.en
# Text that biases the gate's model toward the wake phrase (use the same words as Brain's WAKE_PHRASE)
STT_GATE_PROMPT=Oblivion 306
